<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.hairanalysis.mapper.boka.ConsumptionProjectRecordMapper">

    <resultMap id="ConsumptionProjectRecordMap" type="com.example.hairanalysis.model.ConsumptionProjectRecord">
        <id property="id" column="id"/>
        <result property="compId" column="comp_id"/>
        <result property="billId" column="bill_id"/>
        <result property="billDate" column="bill_date" jdbcType="TIMESTAMP"/>
        <result property="projectName" column="project_name"/>
        <result property="price" column="price"/>
        <result property="totalPrice" column="total_price"/>
    </resultMap>

    <select id="findByStoreAndMonth" resultMap="ConsumptionProjectRecordMap">
        SELECT id,
               comp_id,
               bill_id,
               STR_TO_DATE(bill_date, '%Y-%m-%d %H:%i:%s') AS bill_date,
               project_name,
               price,
               total_price
        FROM bdc_boka_consumption_project_records
        WHERE comp_id = #{storeId}
          AND STR_TO_DATE(bill_date, '%Y-%m-%d %H:%i:%s') BETWEEN #{startDate} AND #{endDate}
    </select>

    <select id="findByBillId" resultMap="ConsumptionProjectRecordMap">
        SELECT id,
               comp_id,
               bill_id,
               STR_TO_DATE(bill_date, '%Y-%m-%d %H:%i:%s') AS bill_date,
               project_name,
               price,
               total_price
        FROM bdc_boka_consumption_project_records
        WHERE bill_id = #{billId}
    </select>
</mapper>
